# ── Server ───────────────────────────────────────────────────────────────────
# Backend uses BACKEND_PORT locally; PORT is supplied by Render in production.
BACKEND_PORT=3001
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated frontend origins allowed to use Socket.IO and media uploads.
# Set the deployed frontend origin(s) in production.
ALLOWED_ORIGINS=http://localhost:3000

# ── Next.js Public Variables ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public Socket.IO and media server URL. Use the backend URL in Vercel.
# Example: https://hometheater-backend.onrender.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Optional writable disk path for uploaded room media.
# MEDIA_STORAGE_DIR=/var/data/hometheater-media
